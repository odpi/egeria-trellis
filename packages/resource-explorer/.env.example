# GitHub
GITHUB_TOKEN=                              # Personal access token (read-only scope sufficient)
GITHUB_WEBHOOK_SECRET=                     # Optional: shared secret for GitHub push webhooks (POST /api/webhook/github)

# pgvector (PostgreSQL) — vector store, shared with Egeria Advisor's own
# egeria_advisor database (see PgVectorConfig in resource_explorer/config.py).
# Defaults below match the shared instance managed by egeria-workspaces-fs's
# compose-configs/shared-infra/shared-infra.yaml (pgvector/pgvector:pg17,
# port 5442) — override only for a from-scratch environment without it, or
# a small local `docker run -p 5442:5432 pgvector/pgvector:pg17` for one.
# PGVECTOR_HOST=localhost
# PGVECTOR_PORT=5442
# PGVECTOR_DBNAME=egeria_advisor
# PGVECTOR_USER=egeria_advisor
# PGVECTOR_PASSWORD=advisor
# PGVECTOR_SCHEMA=resource_explorer

# Registry (project/resource metadata) — defaults to the same shared
# Postgres instance/database as pgvector above, in its own `resource_explorer`
# schema (see RegistryConfig in resource_explorer/config.py). Override to
# fall back to a local SQLite file for a from-scratch environment:
# REGISTRY_DATABASE_URL=sqlite:///data/registry.db

# LLM backend: ollama | openai | anthropic
LLM__BACKEND=ollama
LLM__OLLAMA__BASE_URL=http://localhost:11434
LLM__OLLAMA__MODEL=llama3.1:8b
LLM__OPENAI__MODEL=gpt-4o-mini
LLM__ANTHROPIC__MODEL=claude-haiku-4-5-20251001

# Model tier: dev | demo-gpu | demo-cpu (default: dev). Resolves the Ollama
# model, Ollama's num_ctx ceiling, and the RAG context token budget together
# — see docs/runtime-architecture-plan.md §5 and resource_explorer/config.py's
# TIER_PRESETS (mirrors egeria-advisor's ADVISOR_MODEL_TIER). An explicit
# LLM__OLLAMA__MODEL above still wins over the tier's model.
# EXPLORER_MODEL_TIER=dev

# API keys (standard flat names — loaded directly by the SDK clients)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDINGS__MODEL=all-MiniLM-L6-v2        # sentence-transformers model name
EMBEDDINGS__DEVICE=                        # auto-detected: mps | cuda | cpu

# Observability
OBSERVABILITY__MLFLOW__ENABLED=true
OBSERVABILITY__MLFLOW__TRACKING_URI=http://localhost:5025
OBSERVABILITY__PHOENIX__ENABLED=true
OBSERVABILITY__PHOENIX__COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
OBSERVABILITY__METRICS_DB=data/metrics.db

# Query cache
CACHE__TTL_SECONDS=3600
CACHE__MAX_SIZE=1000
# CACHE__BACKEND=redis
# CACHE__REDIS_URL=redis://localhost:6379

# RAG tuning
RAG__TOP_K=10
RAG__MIN_SCORE=0.15
RAG__MAX_COLLECTIONS_PER_QUERY=3


# Auth — required since multi-user login landed (2026-09-04); see docs/admin-guide.md.
# RE_JWT_SECRET signs this app's own session tokens. RE reads either RE_JWT_SECRET or
# TRELLIS_JWT_SECRET (see auth.py's jwt_secret()), RE_JWT_SECRET winning if both are set —
# same either-name pattern as the Portal secret below, for a compose overlay that feeds in
# the app-agnostic TRELLIS_* name instead. Leave unset and a per-host secret is derived
# instead (logged loudly); sessions then survive a process restart but not a move to
# another machine, which is fine for a single-host dev checkout and not for anything else.
RE_JWT_SECRET=

# Only if this deployment accepts Portal SSO handoff. Must match the Portal's own shared
# secret exactly (EGERIA_ADVISOR_SSO_SECRET on the egeria-quickstart side) — RE reads either
# RE_PORTAL_SECRET or TRELLIS_PORTAL_SECRET (see auth.py's portal_secret()), RE_PORTAL_SECRET
# winning if both are set, whichever a given deployment's compose overlay happens to feed in.
# Leave unset to disable Portal SSO (the tile shows "Not configured" rather than erroring).
# RE_PORTAL_SECRET=

# Optional. Default 8; the effective session length is whichever is shorter, and Egeria's own
# bearer tokens last one hour.
# RE_JWT_TTL_HOURS=8

# Egeria integration (optional — required only for --publish / --refresh)
# Uses standard pyegeria env var names; falls back to pyegeria's config/config.json if unset.
EGERIA_PLATFORM_URL=https://localhost:9443
EGERIA_VIEW_SERVER=qs-view-server
EGERIA_USER=erinoverview
EGERIA_USER_PASSWORD=secret
PYEGERIA_TIMEOUT_SECONDS=30
# Default governance zones assigned to assets when cataloging (comma-separated JSON list)
# EGERIA__DEFAULT_CATALOG_ZONES=["data-lake","analytics"]
# EGERIA__DEFAULT_SURVEY_ZONES=["survey-zone"]

# Kroki (optional — self-hosted mermaid diagram rendering). Defaults to the
# shared egeria-shared-kroki container's published host port (6002 — moved off
# Kroki's own default 8000, which collided with common local dev servers like
# `mkdocs serve`) in a Trellis checkout; see
# egeria-workspaces-fs/compose-configs/shared-infra/shared-infra.yaml.
KROKI_URL=http://localhost:6002

# Prefect (optional — distributed execution for locally-run survey steps only;
# does NOT apply to executes_at: egeria steps, which Egeria coordinates itself
# and RE has no visibility into either way). See docs/Backlog.md's "Distributed
# survey orchestration via a flow tool (Prefect)" entry and
# docs/distributed-survey-orchestration.md for the full design.
#
# Default is TRUE as of 2026-09-19 (project owner decision — see
# PLAN-PREFECT-OR-ALTERNATIVE.md §5 phase 3 and PrefectConfig.enabled's
# docstring in config.py for the full history, including the 2026-09-04 leak
# this default previously guarded against — fixed at the root since, not
# worked around). With no Prefect server reachable at PREFECT_API_URL,
# run_prefect_step still degrades to running the step locally — a checkout
# with no Prefect server keeps working, just without Prefect's retries/
# telemetry for executes_at: prefect steps specifically.
#
# Point PREFECT_API_URL at wherever a compose service actually provides
# Prefect — egeria-workspaces' optional-associated-runtimes/prefect, or an
# equivalent — and set PREFECT_WORK_POOL to a pool a real worker is running
# against. See CLAUDE.md's "External services" section for the setup
# commands (scripts/prefect_up.sh).
PREFECT_API_URL=http://localhost:4200/api
PREFECT_UI_URL=http://localhost:4200
PREFECT_ENABLED=true
PREFECT_WORK_POOL=default-agent-pool
# Also route plain executes_at: resource-explorer steps through Prefect, not
# just steps that explicitly declare executes_at: prefect. Off by default
# even with PREFECT_ENABLED=true — see PrefectConfig.route_local_steps'
# docstring in config.py for why this is a separate, deliberate opt-in.
PREFECT_ROUTE_LOCAL_STEPS=false

# ─── Process roles (docs/process-model.md, docs/runtime-architecture-plan.md §2)
#
# Background loops — the scheduler (which also drains the Egeria outbox and
# reconciles RFA actions inside its own tick), the bootstrap monitor and the
# Egeria resync scanner — belong to the `worker` role, not to the web server.
# Two ways to run them:
#
#   resource-explorer web                       # worker embedded (the default)
#   resource-explorer web --no-embed-worker \
#     + resource-explorer worker                # separate processes
#
# Either way each loop is gated on its own Postgres advisory lock, so a second
# RE process against the same registry logs "standby" instead of double-firing
# every due schedule. Grep a process's log for "worker loop started" /
# "worker loop standby" to see which one holds what.

# Run the worker role inside the web process. Default true, so an existing
# checkout and `make dev` behave exactly as they did when the loops were
# started from the FastAPI lifespan. Set false when a separate
# `resource-explorer worker` owns them — recommended with `web --workers N`,
# where leader election works but N-1 copies hold idle supervisor threads and
# a registry connection each.
# EXPLORER_EMBED_WORKER=true

# Size of the ONE shared thread pool per process that bridges sync
# pyegeria/BeeAI calls into async code (resource_explorer/concurrency.py). It
# replaced six ad hoc pools, one of which had no cap at all. 8 was the old
# per-batch ceiling for question-GUID resolution; these are reads against a
# single Egeria server, so raising it loads someone else's platform rather
# than making this one faster.
# EXPLORER_SYNC_POOL_SIZE=8

# Which UI "/" serves: next (default) or classic. /next and /classic always serve their own.
# RE_DEFAULT_UI=next
