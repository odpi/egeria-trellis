    "rail": "<div class=\"mb-s4 flex flex-wrap items-baseline gap-s3 font-heading text-subtab\">\n    <span class=\"border-b border-accent pb-[2px] text-ink\">Questions</span><button data-subtab=\"survey\" class=\"cursor-pointer bg-transparent text-ink hover:text-accent-ink\">Survey & analyses</button><button data-subtab=\"by_analysis\" class=\"cursor-pointer bg-transparent text-ink hover:text-accent-ink\">By analysis</button><button data-subtab=\"disposition\" class=\"cursor-pointer bg-transparent text-ink hover:text-accent-ink\">Disposition</button>\n  </div>",
    "content": "<div class=\"mb-s4 flex flex-wrap items-baseline gap-s3 font-heading text-subtab\">\n    <span class=\"border-b border-accent pb-[2px] text-ink\">Questions</span><button data-subtab=\"survey\" class=\"cursor-pointer bg-transparent text-ink hover:text-accent-ink\">Survey &amp; analyses</button><button data-subtab=\"by_analysis\" class=\"cursor-pointer bg-transparent text-ink hover:text-accent-ink\">By analysis</button><button data-subtab=\"disposition\" class=\"cursor-pointer bg-transparent text-ink hover:text-accent-ink\">Disposition</button>\n  </div>\n    <div id=\"resource-header\">\n    <div class=\"flex flex-wrap items-baseline gap-s3\">\n      <h3 class=\"m-0 font-heading text-name font-normal\">Fixture</h3>\n      <span class=\"font-mono text-provenance text-ink-muted\">fixture_resource</span>\n      <span class=\"text-caveat text-ink-muted\">no external links recorded</span>\n      <span class=\"ml-auto flex flex-wrap items-baseline gap-s2 text-caveat\">\n        \n        <button data-act=\"disposition\" class=\"cursor-pointer rounded-pill border border-rule-strong bg-transparent px-2 py-[1px] text-ink hover:border-accent\">\n          undecided ▾\n        </button>\n      </span>\n    </div>\n    <div class=\"mt-s1 text-provenance text-ink-muted\">never surveyed · not published to Egeria</div>\n    \n    \n    \n    \n    <div id=\"resource-action\" class=\"mt-s2\"></div></div>\n    <div class=\"mt-s3 flex flex-wrap items-baseline gap-s3 text-provenance\">\n      <span id=\"answered-count\" class=\"tnum text-caveat text-ink-muted\">review and commit · Curate</span>\n    </div>\n    <div id=\"state-legend\" class=\"mt-s2 flex flex-wrap items-baseline gap-s3 text-caveat\"></div>\n    <div class=\"my-s3 h-px bg-rule\"></div>\n    <div id=\"question-rows\"></div><div id=\"curate-host\"><section data-curate-band=\"findable\" class=\"mb-s4 border-b border-rule pb-s2\"><div class=\"text-caveat text-ink-muted\">Reading tags…</div></section>\n    <section data-curate-band=\"kind\" class=\"mb-s4\"><div data-curate-work=\"filesystem\" class=\"text-caveat text-ink-muted\">Nothing to review for file systems yet. Group, tags, ratings and notes above and below apply.</div></section>\n    <section data-curate-band=\"publish\" class=\"mb-s4 border-b border-rule pb-s2\"><div class=\"mb-s1 text-caps uppercase tracking-caps text-ink\">Publish to Egeria</div><div class=\"text-caveat\" data-publish-status=\"\"><span class=\"text-state-warn\" data-cue=\"unrun\" title=\"not run\"><span class=\"font-glyph\" aria-hidden=\"true\">○</span> not in Egeria</span></div>\n    <div class=\"mt-s1 text-provenance text-ink-muted\">A file system has no publish control here yet.</div><div class=\"mt-s2\" data-egeria-reports-host=\"\"><div data-egeria-reports=\"\" class=\"min-w-0\">\n      <div class=\"flex flex-wrap items-baseline gap-x-s2\">\n        <span class=\"text-answer text-ink\">Egeria reports</span>\n        <button type=\"button\" data-reports-refresh=\"\" class=\"cursor-pointer rounded-sm border border-rule-strong bg-transparent px-2 py-[2px] text-caveat text-ink hover:border-accent disabled:cursor-default disabled:opacity-60\">Refresh</button>\n        <span data-reports-status=\"\" class=\"text-provenance text-ink-muted\"></span>\n      </div>\n      <div data-egeria-reports-body=\"\" class=\"mt-s1\"><div class=\"text-caveat text-ink-muted\">Not in Egeria: there is no asset to list reports from.</div></div></div></div></section>\n    <section data-curate-band=\"people\" class=\"mb-s4\"><div class=\"mb-s1 flex flex-wrap items-baseline gap-x-s2 text-caps uppercase tracking-caps text-ink-muted\">\n  <span class=\"text-ink\">What people say</span></div>\n    <div data-curate-ratings=\"\" class=\"mb-s3\"><div class=\"mb-s1 flex flex-wrap items-baseline gap-x-s2 text-caps uppercase tracking-caps text-ink-muted\">\n  <span class=\"text-ink\">Ratings</span><span data-curate-ratings-headline=\"\" class=\"normal-case tracking-normal text-ink\">· none yet · one per person · public in Egeria</span></div>\n    \n    \n    <div class=\"mt-s2 flex flex-wrap items-baseline gap-s2 text-caveat\">\n      <span class=\"text-ink-muted\">rate it</span>\n      <select data-curate-fb-rating=\"\" aria-label=\"rating\" class=\"rounded-sm border border-rule-strong bg-transparent px-1 text-caveat text-ink\">\n        <option value=\"\">No rating</option>\n        <option value=\"5\">★★★★★</option><option value=\"4\">★★★★</option><option value=\"3\">★★★</option><option value=\"2\">★★</option><option value=\"1\">★</option>\n      </select>\n      <select data-curate-fb-category=\"\" aria-label=\"category\" class=\"rounded-sm border border-rule-strong bg-transparent px-1 text-caveat text-ink\">\n        <option value=\"\">Category (optional)</option><option value=\"quality\">Quality</option><option value=\"documentation\">Documentation</option><option value=\"usefulness\">Usefulness</option><option value=\"other\">Other</option>\n      </select>\n    </div>\n    <textarea data-curate-fb-message=\"\" rows=\"2\" placeholder=\"How well did it serve you? A message is required.\" class=\"mt-s1 w-full rounded-sm border border-rule-strong bg-transparent p-s2 text-caveat text-ink placeholder:text-ink-muted\"></textarea>\n    <div class=\"mt-s1 flex items-baseline gap-s3\">\n      <button type=\"button\" data-curate-fb-submit=\"\" class=\"cursor-pointer rounded-sm border border-accent bg-transparent px-2 py-[2px] text-caveat text-accent-ink\">Save rating</button>\n      <span class=\"text-provenance text-ink-muted\">a newer rating replaces yours · sent with Publish</span>\n      <span data-curate-ratings-status=\"\" class=\"text-provenance text-ink-muted\"></span>\n    </div></div>\n    <div data-curate-notes=\"\"><div class=\"mb-s1 flex flex-wrap items-baseline gap-x-s2 text-caps uppercase tracking-caps text-ink-muted\">\n  <span class=\"text-ink\">Notes</span><span class=\"normal-case tracking-normal\">· the journal · why it matters, and to whom · append-only · each entry a public Note in Egeria, sent with Publish</span></div>\n    <div id=\"journal-write\">\n    <textarea id=\"journal-body\" rows=\"4\" placeholder=\"Worth using for anyone who… Note the… before depending on it.\" class=\"w-full rounded-sm border border-rule-strong bg-transparent p-s2 text-answer text-ink placeholder:text-ink-muted\"></textarea>\n    <div class=\"mt-s1 flex flex-wrap items-baseline gap-x-s3 gap-y-[2px] text-caveat\">\n      <span class=\"text-ink-muted\">suggest to</span>\n      \n      <label class=\"flex items-baseline gap-[4px] text-ink-muted\">+ <input id=\"journal-person\" type=\"text\" placeholder=\"a person…\" class=\"w-[12ch] rounded-sm border border-rule-strong bg-transparent px-[4px] text-caveat text-ink placeholder:text-ink-muted\"></label>\n    </div>\n    <div class=\"mt-s2 flex items-baseline gap-s3\">\n      <button id=\"journal-save\" type=\"button\" class=\"cursor-pointer rounded-sm border border-accent bg-transparent px-2 py-[2px] text-answer text-accent-ink\">Save entry</button>\n      <span class=\"text-provenance text-ink-muted\">saved entries are permanent: no edit, no delete\n        · as dan\n        · a suggestion is a work-list entry for them, not a notification</span>\n    </div></div>\n    <div id=\"journal-entries\" class=\"mt-s2 text-caveat text-ink-muted\"><span class=\"text-ink-muted\">Nobody has written about this resource yet.</span></div>\n    <div data-curate-classic-notes=\"\" class=\"mt-s3\"></div></div><div class=\"text-caveat text-state-warn\">A Curate band could not be drawn: groups.map is not a function</div></section></div>"
